# Supabase ダッシュボード > Project Settings > API (または Connect) からコピー
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# 新しい Publishable key (sb_publishable_...) 推奨。旧 anon key でも可
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 任意: QRコードに埋め込むURLのベース（未設定なら開いているURLのオリジンを使用）
# 本番ドメインで管理画面をローカルから開く場合などに設定
# NEXT_PUBLIC_SITE_URL=https://event-cam.vercel.app
